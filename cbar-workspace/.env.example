# ============================================================
# CBAR Workspace — Environment Variables
# Copy this file to .env.local and fill in your Supabase values.
# ============================================================

# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Used ONLY by the Supabase Edge Function (supabase/functions/admin-users)
# Found in: Supabase Dashboard → Project Settings → API → service_role
# NEVER expose this to the browser. It is injected automatically when deployed with the Supabase CLI.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
